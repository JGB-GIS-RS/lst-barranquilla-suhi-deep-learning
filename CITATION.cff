  - "surface urban heat island"
  - "Landsat 8"
  - "Landsat 9"
  - "spatiotemporal deep learning"
  - "U-Net"
  - "ConvLSTM"
  - "squeeze-and-excitation"
  - "NASA POWER"
  - "remote sensing"
  - "Barranquilla"
  - "Colombia"

