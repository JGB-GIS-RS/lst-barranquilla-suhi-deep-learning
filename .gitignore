# Project-specific exclusions

# Local path configuration

configs/paths.yml

# Local environment and credentials

.env
.env.*
*.env
credentials.json
token.json
service_account*.json
*.pem
*.key

# Large geospatial data

*.tif
*.tiff
*.vrt
*.img
*.hdr
*.aux.xml
*.ovr
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qgz
*.qgs

# Tensor, array, and chunked data

*.npy
*.npz
*.h5
*.hdf5
*.zarr
*.nc
*.nc4
*.grib
*.grb
*.parquet
*.feather

# Model checkpoints and weights

*.pt
*.pth
*.ckpt
*.onnx
*.keras
*.h5

# Large or generated data directories

data/raw/
data/processed/
data/tensors/
data/patches/
data/external/
data/interim/

# External output directories

outputs/figures/
outputs/tables/
outputs/maps/
outputs/logs/
outputs/checkpoints/
outputs/diagnostics/
outputs/predictions/

# Experiment tracking and training logs

wandb/
mlruns/
tensorboard/
lightning_logs/

# Temporary files

*.tmp
*.temp
*.bak
*.log
.DS_Store
Thumbs.db

# Jupyter checkpoints

.ipynb_checkpoints/
